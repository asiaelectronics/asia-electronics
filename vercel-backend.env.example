# Vercel env for the BACKEND project (backend/)
# Paste into Vercel → Project → Settings → Environment Variables → "Import .env"
# Environment: Production. Replace every <...> with the real value from backend/.env. Redeploy after saving.

NODE_ENV=production

# CORS allow-list (comma-separated) — also used to build links in emails
FRONTEND_URL=https://www.asiaelectronics.lk,https://asiaelectronics.lk,https://delightful-stack.vercel.app

# Public store URL used in order-status emails
STORE_URL=https://www.asiaelectronics.lk

# Supabase (SECRET)
SUPABASE_URL=<your-supabase-url>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# First admin account (SECRET — only needed when no admin exists yet)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# Gmail SMTP for order-status emails (SECRET)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<yourstore@gmail.com>
SMTP_PASS=<16-character-google-app-password>
EMAIL_FROM=<yourstore@gmail.com>

# Do NOT set on Vercel (provided automatically): PORT, VERCEL, VERCEL_URL, VERCEL_ENV
