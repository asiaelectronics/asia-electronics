# Vercel env for the FRONTEND project (frontend/)
# Paste into Vercel → Project → Settings → Environment Variables → "Import .env"
# Environment: Production. Redeploy after saving.

# Server-side (SSR) API base — fixes "Product not found" on links opened from WhatsApp
API_URL=https://www.asiaelectronics.lk/api

# Build-time API base used by the browser bundle (optional — browser already uses same-origin /api)
VITE_API_URL=https://www.asiaelectronics.lk/api

# Build preset (already set in frontend/vercel.json, listed here for completeness)
NITRO_PRESET=vercel
